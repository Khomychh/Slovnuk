# ─────────────────────────────────────────────────────────────────────────────
# ОБОВ'ЯЗКОВЕ. Без цих двох рядків застосунок не стартує взагалі — pydantic
# кидає ValidationError. Так зроблено навмисно: дефолти тут означали б, що
# продакшен підписує токени рядком із публічного репозиторію, і нічого при
# цьому не ламається — просто будь-хто підробляє токен на будь-кого.
#
# Згенерувати кожен окремо:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Зміна цих значень робить недійсними всі раніше видані токени, тобто всі
# залогінені перелогіняться один раз.
SECRET_KEY_ACCESS=
SECRET_KEY_REFRESH=
# ─────────────────────────────────────────────────────────────────────────────

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_PUBLIC_BUCKET_NAME=slovnuk-storage-public
S3_PRIVATE_BUCKET_NAME=slovnuk-storage-private

# S3-compatible storage endpoints used by the backend.
# S3_STORAGE_ENDPOINT is used for the actual API calls (upload/download/delete).
#   - Inside docker-compose, use the "minio" service name: http://minio:9000
#   - Running the backend directly on the host, use: http://localhost:9000
# S3_STORAGE_PUBLIC_ENDPOINT is used to build URLs handed to the browser, so it
# always needs to be a host the browser can resolve.
#   - Locally: http://localhost:9000
#   - У продакшені MinIO портів не публікує взагалі, і аватар їде через Caddy
#     фронтенду: https://<домен>/media  (див. deploy/README.md). HTTP-адреса на
#     HTTPS-сторінці буде заблокована браузером як mixed content, і мовчки.
S3_STORAGE_ENDPOINT=http://minio:9000
S3_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Postgres. Host defaults to "localhost" for running the backend directly on
# the host machine against a Postgres container with published ports. Inside
# docker-compose the backend service overrides this to POSTGRES_HOST=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=slovnuk
POSTGRES_PASSWORD=slovnuk
POSTGRES_DB=slovnuk

# Порти публікуються ТІЛЬКИ на 127.0.0.1 (див. docker-compose.yml). У
# продакшені docker-compose.prod.yml прибирає їх зовсім, крім Postgres на
# loopback — його потребує SSH-тунель оптимізатора (ADR-0002).
BACKEND_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Порт контейнера фронтенду. НЕ 5173 — той зайнятий `npm run dev`, і два
# фронтенди на одному порту означають «а що я зараз бачу».
FRONTEND_PORT=8080

# Resend (https://resend.com) - used to send transactional emails.
RESEND_API_KEY=
EMAIL_SENDER=no-reply@example.com

# URL the frontend is reachable at - used to build the links sent in
# activation/password-reset emails, and as the allowed CORS origin.
# У продакшені мусить дорівнювати бойовому домену, інакше листи активації
# ведуть у нікуди: https://slovnuk.ivankhomych.com
FRONTEND_BASE_URL=http://localhost:5173

GEMINI_API_KEY=

# Заповнення картки з ШІ (https://console.anthropic.com).
#
# Порожній ключ — це рубильник, а не недоробка: без нього фічі на цьому сервері
# немає взагалі, роут віддає 503, і кнопки не бачить ніхто — навіть той, кому
# видано доступ (`python -m scripts.ai_access grant`). Локальна розробка й тести
# так і працюють: без ключа й без жодного звернення до Claude.
ANTHROPIC_API_KEY=
# Міняється тут, без правки коду. Чи вистачить дешевшої моделі
# (claude-sonnet-5), видно тільки на живих словах і живому рахунку.
AI_MODEL=claude-opus-5
