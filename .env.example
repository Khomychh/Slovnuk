# Required. No defaults — the app will not start without them.
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing them invalidates all issued tokens.
SECRET_KEY_ACCESS=
SECRET_KEY_REFRESH=

# Postgres. POSTGRES_HOST=localhost is for running the backend on the host
# against the container. Inside docker-compose the backend service overrides
# it to "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=slovnuk
POSTGRES_PASSWORD=slovnuk
POSTGRES_DB=slovnuk

# MinIO (S3-compatible storage).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_PUBLIC_BUCKET_NAME=slovnuk-storage-public
S3_PRIVATE_BUCKET_NAME=slovnuk-storage-private

# S3_STORAGE_ENDPOINT — used for API calls (upload/download/delete):
#   inside docker-compose: http://minio:9000
#   backend on the host:   http://localhost:9000
# S3_STORAGE_PUBLIC_ENDPOINT — used to build URLs given to the browser, so it
# must be resolvable by the browser:
#   locally:    http://localhost:9000
#   production: https://<domain>/media  (MinIO publishes no ports; an http URL
#               on an https page is silently blocked as mixed content)
S3_STORAGE_ENDPOINT=http://minio:9000
S3_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Ports are published on 127.0.0.1 only (see docker-compose.yml).
# FRONTEND_PORT is not 5173 — that one is taken by `npm run dev`.
BACKEND_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FRONTEND_PORT=8080

# Resend (https://resend.com) — transactional emails. Empty key: no emails are
# sent, so registered accounts cannot be activated.
RESEND_API_KEY=
EMAIL_SENDER=no-reply@example.com

# Used to build links in activation and password-reset emails, and as the
# allowed CORS origin. In production must equal the real domain.
FRONTEND_BASE_URL=http://localhost:5173

# AI card filling (https://console.anthropic.com). An empty key is a valid
# state, not a misconfiguration: the endpoint returns 503 and the feature is
# absent for everyone, including users granted access via
# `python -m scripts.ai_access grant`. Local development and tests run this way.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
